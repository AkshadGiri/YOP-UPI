# ============================================================================
# UPI-Style App — Server Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ============================================================================

# --- App ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# When true: mock OTP (123456), seeded demo data, mock payment provider only.
# NEVER set this to false without real PSP credentials configured below —
# see /docs/ARCHITECTURE.md → "Real payment integration strategy".
DEMO_MODE=true

# --- Database (PostgreSQL via Prisma) -----------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/upi_app?schema=public"

# --- Redis (OTP, rate limiting, idempotency, temp state) ----------------
REDIS_URL="redis://localhost:6379"

# --- Auth / JWT -----------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- PIN / password hashing (argon2 tuning; defaults are sane) ----------
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- OTP --------------------------------------------------------------
# In DEMO_MODE, this exact code is always accepted for any phone number.
DEV_MOCK_OTP=123456
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
PAYMENT_RATE_LIMIT_MAX_REQUESTS=20

# --- Payment provider abstraction ----------------------------------------
# mock  -> MockPaymentProvider, no real money moves, always used when DEMO_MODE=true
# live  -> RealPaymentProvider, calls the configured PSP below
PAYMENT_MODE=mock

# Real PSP credentials (only required when PAYMENT_MODE=live).
# Placeholder names — swap for your actual PSP (Razorpay/Cashfree/PSP sandbox).
PSP_PROVIDER_NAME=
PSP_API_BASE_URL=
PSP_API_KEY=
PSP_API_SECRET=
PSP_WEBHOOK_SECRET=

# --- CORS -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# --- Logging ----------------------------------------------------------
LOG_LEVEL=info
